<?xml version="1.0" encoding="utf-8"?>
<!-- 0.3.0 Location tab: place search, OpenStreetMap, active location, favourites, recent, advanced. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:text="@string/identra_tab_location"
        android:textAppearance="@style/TextAppearance.Identra.LargeTitle" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/locSearchLayout"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        app:boxBackgroundColor="@color/identra_surface"
        app:boxCornerRadiusBottomEnd="20dp"
        app:boxCornerRadiusBottomStart="20dp"
        app:boxCornerRadiusTopEnd="20dp"
        app:boxCornerRadiusTopStart="20dp"
        app:boxStrokeColor="@color/identra_on_surface_variant"
        app:endIconMode="clear_text"
        app:hintEnabled="false"
        app:startIconDrawable="@drawable/ic_identra_search">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/locSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/identra_loc_search_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/locScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="40dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/locTargetCard"
                    style="@style/Widget.Identra.Card.Tonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="8dp">

                        <ImageView
                            android:id="@+id/locTargetIcon"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:importantForAccessibility="no" />

                        <TextView
                            android:id="@+id/locTargetText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:textAppearance="@style/TextAppearance.Identra.RowTitle" />

                        <Button
                            android:id="@+id/locTargetCancel"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/identra_loc_target_done" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Identra.Card.Hero"
                    android:layout_width="match_parent"
                    android:layout_height="300dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <org.osmdroid.views.MapView
                            android:id="@+id/locMap"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />

                        <!-- 0.4.0: "show selected/spoofed place" and the REAL "my location" are separate -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|end"
                            android:layout_margin="6dp"
                            android:orientation="vertical">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/locRecenter"
                                style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:contentDescription="@string/identra_loc_recenter"
                                app:icon="@drawable/ic_identra_location" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/locMyLocation"
                                style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:contentDescription="@string/identra_loc_my_location"
                                app:icon="@drawable/ic_identra_my_location" />
                        </LinearLayout>

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/locMyProgress"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom"
                            android:indeterminate="true"
                            android:visibility="gone"
                            app:trackThickness="3dp" />

                        <TextView
                            android:id="@+id/locMapHint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top|start"
                            android:layout_margin="10dp"
                            android:background="@drawable/bg_identra_results"
                            android:paddingStart="10dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="4dp"
                            android:text="@string/identra_loc_map_hint"
                            android:textAppearance="@style/TextAppearance.Identra.Caption" />
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- current selection -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/locSelCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/bg_identra_icon_circle"
                                android:importantForAccessibility="no"
                                android:padding="9dp"
                                android:src="@drawable/ic_identra_location" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/locSelName"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="end"
                                    android:maxLines="2"
                                    android:textAppearance="@style/TextAppearance.Identra.CardTitle" />

                                <TextView
                                    android:id="@+id/locSelCoords"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:textAppearance="@style/TextAppearance.Identra.RowSub" />
                            </LinearLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/locSelStar"
                                style="@style/Widget.Material3.Button.IconButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:contentDescription="@string/identra_loc_favourite"
                                app:icon="@drawable/ic_identra_star_outline" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/locSelAll"
                                style="@style/Widget.Material3.Button"
                                android:layout_width="0dp"
                                android:layout_height="52dp"
                                android:layout_marginEnd="6dp"
                                android:layout_weight="1"
                                android:text="@string/identra_loc_set_all"
                                app:cornerRadius="16dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/locSelApp"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="0dp"
                                android:layout_height="52dp"
                                android:layout_marginStart="6dp"
                                android:layout_weight="1"
                                android:text="@string/identra_loc_set_app"
                                app:cornerRadius="16dp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/identra_loc_active"
                    android:textAppearance="@style/TextAppearance.Identra.Section" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:id="@+id/locActive"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/locActiveNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="8dp"
                    android:text="@string/identra_loc_note"
                    android:textAppearance="@style/TextAppearance.Identra.Caption" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/identra_loc_favourites"
                    android:textAppearance="@style/TextAppearance.Identra.Section" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/locFavs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:chipSpacingHorizontal="8dp" />

                <TextView
                    android:id="@+id/locFavsEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/identra_loc_favourites_empty"
                    android:textAppearance="@style/TextAppearance.Identra.RowSub" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:text="@string/identra_loc_recent"
                        android:textAppearance="@style/TextAppearance.Identra.Section" />

                    <Button
                        android:id="@+id/locRecentClear"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/identra_loc_clear" />
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/locRecentCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:id="@+id/locRecent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/locRecentEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/identra_loc_recent_empty"
                    android:textAppearance="@style/TextAppearance.Identra.RowSub"
                    android:visibility="gone" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp">

                    <LinearLayout
                        android:id="@+id/locAdvancedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- search results overlay -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/locResults"
            style="@style/Widget.Identra.Card.Hero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginStart="16dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="16dp"
            android:visibility="gone"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/locResultsProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:indeterminate="true"
                    android:visibility="gone"
                    app:trackThickness="2dp" />

                <TextView
                    android:id="@+id/locResultsMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp"
                    android:textAppearance="@style/TextAppearance.Identra.RowSub"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/locResultsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="10dp"
                    android:text="@string/identra_loc_attribution"
                    android:textAppearance="@style/TextAppearance.Identra.Caption" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>
</LinearLayout>
