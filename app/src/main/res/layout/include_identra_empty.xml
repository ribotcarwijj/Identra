<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="40dp"
    android:paddingTop="24dp"
    android:paddingEnd="40dp"
    android:paddingBottom="24dp">

    <ImageView
        android:id="@+id/identraEmptyArt"
        android:layout_width="160dp"
        android:layout_height="120dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ill_identra_empty" />

    <TextView
        android:id="@+id/identraEmptyTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.Identra.CardTitle" />

    <TextView
        android:id="@+id/identraEmptyBody"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.Identra.RowSub"
        android:visibility="gone" />
</LinearLayout>
