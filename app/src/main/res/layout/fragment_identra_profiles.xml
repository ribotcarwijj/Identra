<?xml version="1.0" encoding="utf-8"?>
<!-- 0.4.0 Profiles tab: list of device identities, global default, create / import / export. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/identra_tab_profiles"
            android:textAppearance="@style/TextAppearance.Identra.LargeTitle" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/profImport"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/identra_prof_import"
            app:icon="@drawable/ic_identra_download" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/profExport"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/identra_prof_export_all"
            app:icon="@drawable/ic_identra_upload" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="20dp"
        android:text="@string/identra_prof_intro"
        android:textAppearance="@style/TextAppearance.Identra.RowSub" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/profList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="104dp" />

        <include
            android:id="@+id/profEmpty"
            layout="@layout/include_identra_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/profNew"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:text="@string/identra_prof_new"
            app:backgroundTint="@color/identra_primary"
            app:icon="@drawable/ic_identra_add"
            app:iconTint="@color/identra_on_primary"
            android:textColor="@color/identra_on_primary" />
    </FrameLayout>
</LinearLayout>
