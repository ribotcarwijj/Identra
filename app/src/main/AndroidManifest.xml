<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    >

    <!-- https://developer.android.com/preview/privacy/package-visibility -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- 0.3.0: Location tab (place search + OpenStreetMap tiles) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 0.4.0: Location tab "My location" reads the real position (asked at runtime) -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <application
        android:requestLegacyExternalStorage="false"

        android:name="ApplicationEx"
        android:allowBackup="false"
        android:appCategory="productivity"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppThemeLight">

        <receiver
            android:name=".debug.SelfTestReceiver"
            android:exported="false" />

        <!-- 0.6.0 Found in this app: scan after install / update (sent by Identra's system part) -->
        <receiver
            android:name=".found.FoundScanReceiver"
            android:exported="false" />

        <service
            android:name=".found.FoundScanJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- New UI (0.2.0): launcher with bottom tabs -->
        <activity
            android:name=".ui.HomeActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustPan"
            android:theme="@style/Theme.Identra">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.AppDetailActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:parentActivityName=".ui.HomeActivity"
            android:resizeableActivity="true"
            android:theme="@style/Theme.Identra" />


        <!-- 0.3.0: advanced tools rebuilt in the new style -->
        <activity android:name=".ui.tools.IdentraHooksActivity" android:exported="false" android:theme="@style/Theme.Identra" android:parentActivityName=".ui.HomeActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.tools.IdentraValuesActivity" android:exported="false" android:theme="@style/Theme.Identra" android:parentActivityName=".ui.HomeActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.tools.IdentraBackupActivity" android:exported="false" android:theme="@style/Theme.Identra" android:parentActivityName=".ui.HomeActivity" />
        <activity android:name=".ui.profiles.ProfileEditorActivity" android:exported="false" android:theme="@style/Theme.Identra" android:parentActivityName=".ui.HomeActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.tools.IdentraHookEditorActivity" android:exported="false" android:theme="@style/Theme.Identra" android:parentActivityName=".ui.HomeActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.tools.IdentraHelpActivity" android:exported="false" android:theme="@style/Theme.Identra" android:parentActivityName=".ui.HomeActivity" />
        <activity android:name=".ui.tools.IdentraLogActivity" android:exported="false" android:theme="@style/Theme.Identra" android:parentActivityName=".ui.HomeActivity" android:windowSoftInputMode="adjustResize" />

        <!-- 0.5.0: legacy screens kept in code only; not exported and no entry point in the UI -->
        <activity
            android:name=".ActivityMain"
            android:exported="false"
            android:configChanges="orientation|screenSize"
            android:launchMode="singleTask"
            android:resizeableActivity="true" />


        <activity
            android:name=".x.ui.activities.HooksExActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize"
            android:label="@string/menu_hooks"
            android:launchMode="singleTop"
            android:parentActivityName=".ui.HomeActivity"
            android:resizeableActivity="true">
            <meta-data android:name="android.support.PARENT_ACTIVITY" android:value=".ui.HomeActivity" />
        </activity>

        <activity
            android:name=".ActivityProperties"
            android:exported="false"
            android:configChanges="orientation|screenSize"
            android:label="@string/menu_props"
            android:launchMode="singleTop"
            android:parentActivityName=".ui.HomeActivity"
            android:resizeableActivity="true">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".ui.HomeActivity" />
        </activity>

        <activity
            android:name=".ActivityAppControl"
            android:exported="false"
            android:configChanges="orientation|screenSize"
            android:label="@string/menu_hooks"
            android:launchMode="singleTop"
            android:parentActivityName=".ui.HomeActivity"
            android:resizeableActivity="true">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".ui.HomeActivity" />
        </activity>


        <activity
            android:name=".ActivitySettings"
            android:exported="false"
            android:configChanges="orientation|screenSize"
            android:label="@string/menu_settings"
            android:launchMode="singleTop"
            android:parentActivityName=".ui.HomeActivity"
            android:resizeableActivity="true">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".ui.HomeActivity" />
        </activity>

        <activity
            android:name=".x.ui.activities.SettingsExActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize"
            android:label="@string/menu_settings"
            android:launchMode="singleTop"
            android:parentActivityName=".ui.HomeActivity"
            android:resizeableActivity="true">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".ui.HomeActivity" />
        </activity>

        <activity
            android:name=".ActivityConfig"
            android:exported="false"
            android:configChanges="orientation|screenSize"
            android:label="@string/menu_configs"
            android:launchMode="singleTop"
            android:parentActivityName=".ui.HomeActivity"
            android:resizeableActivity="true">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".ui.HomeActivity" />
        </activity>

        <activity
            android:name=".ActivityDatabase"
            android:exported="false"
            android:configChanges="orientation|screenSize"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:parentActivityName=".ui.HomeActivity"
            android:resizeableActivity="true">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".ui.HomeActivity" />
        </activity>



        <activity
            android:name=".ActivityCpu"
            android:exported="false"
            android:configChanges="orientation|screenSize"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:parentActivityName=".ui.HomeActivity"
            android:resizeableActivity="true">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".ui.HomeActivity" />
        </activity>

        <provider
            android:name=".VXP"
            android:exported="true"
            android:authorities="${applicationId}.vxp"
            android:process=":vxp" />
        <!-- libxposed service provider (from the vendored io.github.libxposed.service sources) -->
        <provider
            android:name="io.github.libxposed.service.XposedProvider"
            android:authorities="${applicationId}.XposedService"
            android:exported="true"
            tools:ignore="ExportedContentProvider" />
    </application>
</manifest>
